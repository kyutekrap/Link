#flow

/*
multi-line comment
*/

@debug(true)

@global(A, "Hello")
@global(AB, -1.23)
@global(ABC, ["A", "B", "C"])
@global(ABCD, [AB, 2.2, 3.3])
@global(ABCDE, ABCD)
@global(Grid1, [[1, 2, 3], [1, 2, 3], [1, 2, 3]])
@global(Grid2, [ABCD, ABCD, ABCD])
@global(Grid3, [[1.1, 2.2, 3.3], ABCD, ABCD])

@import("./src/test.link")
@import("./src/test2.link")
@import("./libs/neutrocon/main.h")

@local(A1, "Hello")
@local(AB1, -1.23)
@local(ABC1, ["A", "B", "C"])
// @local(ABCD1, [AB, 2.2, 3.3])
// @local(ABCDE1, ABCD)
@local(Grid11, [[1, 2, 3], [1, 2, 3], [1, 2, 3]])
// @local(Grid21, [ABCD, ABCD, ABCD])
// @local(Grid31, [[1.1, 2.2, 3.3], ABCD, ABCD])

depends(A, {[eq("Hello")], [test2()]})
depends(AB, {[gt(0), lt(100)], [test2(), die()]})

while(A, {[gt(0)], [test2()]})
while(AB, {[gt(0), gt(100)], [test2(), die()]})

info(A)
error(AB)