#flow

/*
multi-line comment
*/

@debug(true)

@set(A, "Hello")
@set(AB, 123)
@set(ABC, ["A", "B", "C"])
@set(ABCD, [1, 2, 3])

@import("./src/test2.link")

depends(A, {[eq("Hello")], [test2()]})
depends(AB, {[gt(0), lt(100)], [test2(), die()]})

while(A, {[gt(0)], [test2()]})
while(AB, {[gt(0), gt(100)], [test2(), die()]})

info(A)
error(AB)