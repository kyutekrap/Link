#flow

/*
multi-line comment
*/

@debug(true)

@global(A, "Hello")
@global(AB, -123)
@global(ABC, ["A", "B", "C"])
@global(ABCD, [1.1, 2.2, 3.3])
@global(Map1, {ABC, ABC})
@global(Map2, {ABC, [1, 2, 3]})

@import("./src/test.link")
@import("./src/test2.link")
@import("./libs/list/main.h")

depends(A, {[eq("Hello")], [test2()]})
depends(AB, {[gt(0), lt(100)], [test2(), die()]})

while(A, {[gt(0)], [test2()]})
while(AB, {[gt(0), gt(100)], [test2(), die()]})

info(A)
error(AB)